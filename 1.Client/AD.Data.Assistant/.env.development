VITE_APP_BASE=/
# mock: datos en duro. api: backend propio (report-agent-ai, 2.Server) por el proxy /agent de Vite.
# Para modo api crea .env.local con VITE_DATA_MODE=api y VITE_DATA_API_KEY=<Auth__ApiKey del servidor>.
# VITE_DATA_API_TARGET cambia el destino del proxy (p. ej. http://localhost:5099 con la API en local).
VITE_DATA_MODE=mock
VITE_DATA_API_URL=/agent
