{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "ModelContextProtocol": "Warning" }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "Model": "claude-opus-5-5",
    "Effort": "high",
    "MaxTokens": 64000,
    "DefaultMaxIterations": 12,
    "MaxIterationsLimit": 25
  },
  "SqlMcp": {
    "Command": "node",
    "Script": "/opt/addaccion-mcp-sql/dist/index.js",
    "Encrypt": false,
    "TrustCert": true,
    "MaxRows": 1000
  },
  "Storage": { "Owner": "admin" }
}
